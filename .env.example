# ZilyaDigital — SATU file env di root repo.
# Salin file ini menjadi `.env` (dari `.env.local` bila perlu), lalu isi sesuai kebutuhan.
# Berlaku untuk FRONTEND (Astro) dan BACKEND (Go) — keduanya membaca file init ini.
# JANGAN commit `.env` / `.env.local` (sudah di-ignore); hanya `.env.example` yang di-commit.

# ── Backend: Go Fiber ─────────────────────────────────────────────────────────
# Port HTTP API backend (dibaca oleh backend; frontend TIDAK memakai PORT ini).
PORT=8080
# URL PocketBase (database).
PB_URL=https://db.nazilah.id
# Superuser PocketBase untuk operasi admin-data di sisi server.
PB_SUPERUSER_EMAIL=superuser@example.com
PB_SUPERUSER_PASSWORD=your_superuser_password
# URL publik situs (tembus ke client browser, dipakai callback DOKU & cookie Secure).
BASE_URL=http://localhost:3000

# ── Backend: DOKU Payment Gateway (opsional, tanpa ini checkout mengembalikan galat) ──
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=

# ── Backend: notifikasi email (opsional) ──
RESEND_API_KEY=
ADMIN_EMAIL=admin@zilyadigital.com

# ── Backend: chatbot AI (opsional — pakai salah satu provider) ──
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# ── Frontend: Astro ──────────────────────────────────────────────────────────
# Alamat backend Go (dipakai fetch server-side + proxy /api/*).
BACKEND_URL=http://127.0.0.1:8080
# Domain publik untuk sitemap.xml.
SITE_URL=https://zilyadigital.com

# Port server Astro (dev & production standalone = 3000) TIDAK diambil dari file ini;
# atur lewat CLI/OS env bila perlu, misal: PORT=3000 npm run preview.