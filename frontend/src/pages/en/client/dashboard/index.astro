---
import Layout from '@/layouts/Layout.astro';
import { getLangFromUrl } from '@/i18n/utils';
import { isAuthed, clientLoginPath } from '@/lib/guards';
import { apiClient } from '@/lib/server';
import ClientLogout from '@/components/client/ClientLogout.tsx';
import TicketForm from '@/components/client/TicketForm.tsx';
import PayButton from '@/components/client/PayButton.tsx';
import Lucide from '@/components/Lucide.astro';

const lang = getLangFromUrl(Astro.url);
const token = Astro.cookies.get('client_token')?.value;

if (!isAuthed(token)) {
  return Astro.redirect(clientLoginPath(lang));
}

interface DashResp {
  client: { id: string; name: string };
  projects: Record<string, any>[];
  assets: Record<string, any>[];
  invoices: Record<string, any>[];
  tickets: Record<string, any>[];
}

let data: DashResp;
try {
  data = await apiClient<DashResp>('/api/client/dashboard', token!);
} catch {
  return Astro.redirect(clientLoginPath(lang));
}

const PHASE_LABELS: Record<string, string> = {
  desain: '1. Design & Wireframe',
  development: '2. Backend & Frontend Dev',
  testing: '3. QA, Security & Speed',
  launch: '4. Deployment & Launch',
};
const PHASES = ['desain', 'development', 'testing', 'launch'];

const STATUS: Record<string, { label: string; icon: any; cls: string }> = {
  pending: { label: 'Pending Start', icon: 'clock', cls: 'bg-amber-500/10 text-amber-300 border border-amber-500/30' },
  in_progress: { label: 'In Progress', icon: 'wrench', cls: 'bg-blue-500/10 text-blue-300 border border-blue-500/30' },
  review: { label: 'Client Review', icon: 'check-circle', cls: 'bg-purple-500/10 text-purple-300 border border-purple-500/30' },
  done: { label: 'Completed & Live', icon: 'rocket', cls: 'bg-emerald-500/10 text-emerald-300 border border-emerald-500/30' },
};

const INVOICE_STATUS: Record<string, { label: string; cls: string }> = {
  paid: { label: 'Paid', cls: 'bg-emerald-500/10 text-emerald-300 border border-emerald-500/30' },
  unpaid: { label: 'Awaiting Payment', cls: 'bg-amber-500/10 text-amber-300 border border-amber-500/30' },
  overdue: { label: 'Overdue', cls: 'bg-red-500/10 text-red-300 border border-red-500/30' },
};

const TICKET_STATUS: Record<string, { label: string; cls: string }> = {
  open: { label: 'Awaiting Response', cls: 'bg-blue-500/10 text-blue-300 border border-blue-500/30' },
  resolved: { label: 'Resolved', cls: 'bg-emerald-500/10 text-emerald-300 border border-emerald-500/30' },
};

const fmtDate = (v?: string | null) => {
  if (!v) return '—';
  const d = new Date(v);
  return Number.isNaN(d.getTime()) ? '—' : d.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
};

const projectMap = Object.fromEntries(data.projects.map((p) => [p.id, p]));
const clientName = data.client.name ?? 'Valued Client';
const waSupport = 'https://wa.me/6281234567890?text=' + encodeURIComponent(`Hello ZilyaDigital Support, I am ${clientName} checking on my project status.`);
---

<Layout title="Client Executive Portal | ZilyaDigital" locale={lang}>
  <div class="min-h-screen bg-zinc-950 text-white pt-28 pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Header Bar */}
      <div class="flex flex-wrap items-center justify-between gap-4 mb-10 pb-6 border-b border-white/10">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-xs font-semibold text-blue-400 mb-2">
            <span>● Active Client Session</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">Client Executive Portal</h1>
          <p class="text-sm text-zinc-400 mt-1">Welcome back, <strong class="text-white">{clientName}</strong></p>
        </div>
        <div class="flex items-center gap-3">
          <a
            href={waSupport}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 text-xs font-semibold transition-all"
          >
            <span>Priority WhatsApp Support</span>
            <span>↗</span>
          </a>
          <ClientLogout client:load lang={lang} />
        </div>
      </div>

      <!-- Active Projects & Milestones -->
      <section class="mb-14">
        <div class="flex items-center gap-2 mb-6">
          <div class="h-2.5 w-2.5 rounded-full bg-blue-500 animate-pulse" />
          <h2 class="text-xl font-bold text-white tracking-tight">Active Projects & Milestone Roadmap</h2>
        </div>

        {data.projects.length === 0 ? (
          <div class="text-center border border-white/10 rounded-3xl py-16 bg-white/[0.02]">
            <p class="text-zinc-400 text-sm">No active projects found for your account.</p>
          </div>
        ) : (
          <div class="grid gap-6 md:grid-cols-2">
            {data.projects.map((project) => {
              const status = STATUS[project.status] ?? STATUS.pending;
              const phaseIdx = PHASES.indexOf(project.phase);
              const assets = data.assets.filter((a) => a.projectId === project.id);
              const progress = Math.min(100, Math.max(0, Number(project.progressPercent) || 0));

              return (
                <article class="rounded-[2rem] p-1.5 bg-gradient-to-b from-white/15 via-white/5 to-transparent border border-white/10 shadow-2xl backdrop-blur-xl">
                  <div class="rounded-[1.7rem] bg-zinc-950 p-6 sm:p-7 border border-white/10 flex flex-col justify-between h-full">
                    <div>
                      <div class="flex items-start justify-between gap-3 mb-3">
                        <h3 class="text-lg font-bold text-white">{project.title}</h3>
                        <span class={`shrink-0 inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full ${status.cls}`}>
                          <Lucide name={status.icon} class="w-3.5 h-3.5" />
                          {status.label}
                        </span>
                      </div>
                      <p class="text-xs sm:text-sm text-zinc-400 mb-6 leading-relaxed">{project.description}</p>

                      {/* Progress Bar */}
                      <div class="mb-6">
                        <div class="flex items-center justify-between mb-2">
                          <span class="text-xs font-semibold text-zinc-400 uppercase tracking-wider">Overall Completion</span>
                          <span class="text-xs font-mono font-bold text-blue-400">{progress}%</span>
                        </div>
                        <div class="h-2.5 w-full rounded-full bg-zinc-900 border border-white/5 overflow-hidden">
                          <div class="h-full rounded-full bg-gradient-to-r from-blue-500 via-indigo-500 to-purple-500 transition-all duration-700 shadow-[0_0_10px_rgba(59,130,246,0.5)]" style={`width: ${progress}%`} />
                        </div>
                      </div>

                      {/* Milestone Phases Track */}
                      <div class="mb-6 p-4 rounded-2xl bg-white/[0.02] border border-white/5">
                        <div class="text-[11px] font-semibold text-zinc-400 uppercase tracking-wider mb-3">
                          Project Phases (Milestones)
                        </div>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                          {PHASES.map((phase, idx) => {
                            const done = idx < phaseIdx;
                            const active = idx === phaseIdx;
                            return (
                              <div class="flex flex-col">
                                <div class={`h-1.5 rounded-full ${done ? 'bg-emerald-500' : active ? 'bg-blue-500 animate-pulse' : 'bg-zinc-800'}`} />
                                <p class={`mt-1.5 text-[10px] font-medium leading-tight ${active ? 'text-blue-300 font-bold' : done ? 'text-zinc-300' : 'text-zinc-500'}`}>
                                  {PHASE_LABELS[phase]}
                                </p>
                              </div>
                            );
                          })}
                        </div>
                      </div>

                      {/* Schedule Meta */}
                      <div class="grid grid-cols-2 gap-3 text-xs bg-white/[0.02] rounded-xl p-3 border border-white/5 mb-6">
                        <div>
                          <span class="text-zinc-500 block mb-0.5">Start Date:</span>
                          <strong class="text-zinc-200">{fmtDate(project.startedAt)}</strong>
                        </div>
                        <div>
                          <span class="text-zinc-500 block mb-0.5">Est. Delivery:</span>
                          <strong class="text-zinc-200">{fmtDate(project.deliveredAt)}</strong>
                        </div>
                      </div>

                      {project.notes && (
                        <div class="text-xs text-zinc-300 bg-blue-500/10 border border-blue-500/20 rounded-xl p-3 mb-4">
                          <strong class="text-blue-400 block mb-1">Team Notes:</strong>
                          {project.notes}
                        </div>
                      )}
                    </div>

                    {assets.length > 0 && (
                      <div class="pt-4 border-t border-white/10 space-y-2">
                        <p class="text-xs font-semibold text-zinc-400">Delivered Assets & Files:</p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                          {assets.map((asset) => (
                            <a
                              href={asset.fileUrl}
                              target="_blank"
                              rel="noreferrer"
                              class="flex items-center gap-2 text-xs text-blue-400 hover:text-blue-300 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl px-3 py-2 transition-colors truncate"
                            >
                              <Lucide name="download" class="w-3.5 h-3.5 shrink-0" />
                              <span class="truncate">{asset.fileName}</span>
                            </a>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </section>

      <!-- Billing & DOKU Payment -->
      <section class="mb-14">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-2">
            <div class="h-2.5 w-2.5 rounded-full bg-emerald-500" />
            <h2 class="text-xl font-bold text-white tracking-tight">Billing & Invoices (DOKU Gateway)</h2>
          </div>
          <span class="text-xs text-zinc-400 hidden sm:inline">QRIS • Bank Virtual Account • Credit Cards</span>
        </div>

        {data.invoices.length === 0 ? (
          <div class="text-center border border-white/10 rounded-3xl py-12 bg-white/[0.02]">
            <p class="text-zinc-400 text-sm">No pending invoices found for your account.</p>
          </div>
        ) : (
          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {data.invoices.map((invoice) => {
              const badge = INVOICE_STATUS[invoice.status] ?? INVOICE_STATUS.unpaid;
              const project = projectMap[invoice.projectId] ?? {};
              const amount = Number(invoice.amount) || 0;
              return (
                <div class="rounded-2xl p-5 bg-white/[0.03] border border-white/10 flex flex-col justify-between hover:border-emerald-500/30 transition-all">
                  <div>
                    <div class="flex items-start justify-between gap-2 mb-3">
                      <div class="flex items-center gap-1.5 text-zinc-400 text-xs">
                        <Lucide name="receipt" class="w-3.5 h-3.5 text-emerald-400" />
                        <span class="font-medium truncate">{project.title ?? 'Project Invoice'}</span>
                      </div>
                      <span class={`shrink-0 text-[11px] font-semibold px-2.5 py-0.5 rounded-full ${badge.cls}`}>
                        {badge.label}
                      </span>
                    </div>
                    <p class="text-xs text-zinc-300 mb-3">{invoice.description}</p>
                    <div class="text-2xl font-black text-white font-mono mb-2">
                      Rp {amount.toLocaleString('id-ID')}
                    </div>
                    <p class="text-[11px] text-zinc-500">
                      Due date: {invoice.dueDate ? fmtDate(invoice.dueDate) : '—'}
                    </p>
                  </div>
                  {invoice.status === 'unpaid' && (
                    <div class="pt-4 mt-4 border-t border-white/5">
                      <PayButton client:load invoiceId={invoice.id} />
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        )}
      </section>

      <!-- Support Tickets -->
      <section class="mb-14">
        <div class="flex items-center gap-2 mb-6">
          <div class="h-2.5 w-2.5 rounded-full bg-purple-500" />
          <h2 class="text-xl font-bold text-white tracking-tight">Support Tickets & Revisions</h2>
        </div>

        <div class="grid gap-6 lg:grid-cols-3">
          <div class="rounded-2xl bg-white/[0.03] border border-white/10 p-6">
            <div class="flex items-center gap-2 mb-4">
              <Lucide name="life-buoy" class="w-4 h-4 text-purple-400" />
              <h3 class="text-sm font-bold text-white">Create New Support Ticket</h3>
            </div>
            <TicketForm client:load />
          </div>

          <div class="lg:col-span-2 space-y-3">
            {data.tickets.length === 0 ? (
              <div class="text-center border border-white/10 rounded-2xl py-12 bg-white/[0.02]">
                <p class="text-zinc-500 text-sm">No support tickets created yet.</p>
              </div>
            ) : (
              data.tickets.slice().reverse().map((ticket) => {
                const badge = TICKET_STATUS[ticket.status] ?? TICKET_STATUS.open;
                return (
                  <div class="rounded-xl bg-white/[0.02] border border-white/10 p-4">
                    <div class="flex items-start justify-between gap-3 mb-1.5">
                      <p class="text-sm font-bold text-white">{ticket.subject}</p>
                      <span class={`shrink-0 text-[10px] font-semibold px-2.5 py-0.5 rounded-full ${badge.cls}`}>{badge.label}</span>
                    </div>
                    <p class="text-xs text-zinc-300 mb-2 leading-relaxed">{ticket.message}</p>
                    <p class="text-[10px] text-zinc-500">{fmtDate(ticket.createdAt)}</p>
                  </div>
                );
              })
            )}
          </div>
        </div>
      </section>

      <!-- Support Banner -->
      <section class="rounded-3xl bg-gradient-to-r from-blue-900/40 via-purple-900/30 to-zinc-900 border border-white/10 p-8 sm:p-10 text-center">
        <h2 class="text-xl sm:text-2xl font-bold mb-2 text-white">Need immediate assistance or direct consultation?</h2>
        <p class="text-zinc-300 mb-6 text-xs sm:text-sm max-w-xl mx-auto">
          Our Technical Lead is directly reachable via WhatsApp for urgent inquiries and priority project changes.
        </p>
        <a
          href={waSupport}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-white text-black font-bold text-xs sm:text-sm px-7 py-3 hover:bg-zinc-200 transition-all shadow-xl shadow-white/10"
        >
          <span>Chat via Priority WhatsApp</span>
          <span>↗</span>
        </a>
      </section>
    </div>
  </div>
</Layout>
