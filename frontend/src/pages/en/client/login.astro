---
import '../../../styles/globals.css';
import type { Locale } from '@/i18n/ui';
import { getLangFromUrl, localeHref } from '@/i18n/utils';
import { getEnv } from '@/lib/env';
import ClientLoginForm from '@/components/client/ClientLoginForm.tsx';
import ArrowLeft from '@/components/Lucide.astro';

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const home = localeHref(lang, '/');
const year = new Date().getFullYear();
const turnstileSiteKey = getEnv('TURNSTILE_SITE_KEY', '0x4AAAAAAFPmeHthhMli5uB_');
---

<html lang={lang} class="dark h-full antialiased scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <title>Client Portal — Sign In & Register | ZilyaDigital</title>
    <meta
      name="description"
      content="Access your ZilyaDigital client portal to track project milestones, download deliverables, manage invoices, and request priority support."
    />
  </head>
  <body class="min-h-screen w-full flex flex-col lg:flex-row bg-zinc-950 text-zinc-100 selection:bg-blue-600/30">
    <!-- Left Pane: Showcase & Branding -->
    <div class="hidden lg:flex w-1/2 bg-zinc-950 relative overflow-hidden flex-col justify-between p-12 xl:p-16 border-r border-zinc-800/70">
      <!-- Glow background decoration -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute -top-24 -left-24 w-96 h-96 bg-blue-600/20 rounded-full blur-[120px]"></div>
        <div class="absolute bottom-12 right-12 w-96 h-96 bg-indigo-600/15 rounded-full blur-[140px]"></div>
        <div class="absolute inset-0 bg-[radial-gradient(#27272a_1px,transparent_1px)] [background-size:24px_24px] opacity-40"></div>
      </div>

      <!-- Top brand -->
      <div class="relative z-10 flex items-center justify-between">
        <a href={home} class="flex items-center gap-3 group">
          <img
            src="/logo.jpg"
            alt="ZilyaDigital Logo"
            width={40}
            height={40}
            class="rounded-xl shadow-lg ring-1 ring-white/10 group-hover:ring-blue-500/50 transition-all duration-300"
          />
          <div>
            <span class="text-xl font-bold text-white tracking-tight block">ZilyaDigital</span>
            <span class="text-xs text-zinc-400">Client Workspace</span>
          </div>
        </a>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          System Online
        </span>
      </div>

      <!-- Center Hero Message & Value Props -->
      <div class="relative z-10 max-w-lg space-y-8 my-auto py-12">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold uppercase tracking-wider">
            Unified Collaboration Hub
          </div>
          <h1 class="text-3xl xl:text-4xl font-extrabold text-white leading-tight tracking-tight">
            Track Projects & Digital Assets in One Place.
          </h1>
          <p class="text-zinc-400 text-base leading-relaxed">
            Gain full transparency over engineering sprint milestones, code delivery, design revisions, and official invoice records.
          </p>
        </div>

        <!-- 4 Key Advantages -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="p-4 rounded-2xl bg-zinc-900/60 border border-zinc-800/80 backdrop-blur-sm hover:border-zinc-700 transition-colors">
            <div class="w-8 h-8 rounded-lg bg-blue-600/15 text-blue-400 flex items-center justify-center font-bold text-base mb-2.5">
              🚀
            </div>
            <h2 class="text-sm font-semibold text-white mb-1">Real-time Milestones</h2>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Track progress, commits, and production deployments without waiting for manual status updates.
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-zinc-900/60 border border-zinc-800/80 backdrop-blur-sm hover:border-zinc-700 transition-colors">
            <div class="w-8 h-8 rounded-lg bg-indigo-600/15 text-indigo-400 flex items-center justify-center font-bold text-base mb-2.5">
              📦
            </div>
            <h2 class="text-sm font-semibold text-white mb-1">Direct Asset Access</h2>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Safely download source repositories, Figma mocks, credentials, and production bundles.
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-zinc-900/60 border border-zinc-800/80 backdrop-blur-sm hover:border-zinc-700 transition-colors">
            <div class="w-8 h-8 rounded-lg bg-emerald-600/15 text-emerald-400 flex items-center justify-center font-bold text-base mb-2.5">
              💳
            </div>
            <h2 class="text-sm font-semibold text-white mb-1">Transparent Billing</h2>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Manage installment milestones, instant payment proofs, and tax-ready PDF invoices.
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-zinc-900/60 border border-zinc-800/80 backdrop-blur-sm hover:border-zinc-700 transition-colors">
            <div class="w-8 h-8 rounded-lg bg-amber-600/15 text-amber-400 flex items-center justify-center font-bold text-base mb-2.5">
              💬
            </div>
            <h2 class="text-sm font-semibold text-white mb-1">Priority Support</h2>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Direct incident tickets and immediate access to senior technical leads for rapid resolution.
            </p>
          </div>
        </div>
      </div>

      <!-- Bottom footer note -->
      <div class="relative z-10 flex items-center justify-between text-xs text-zinc-500 border-t border-zinc-800/60 pt-6">
        <p>&copy; {year} ZilyaDigital. All rights reserved.</p>
        <span class="text-zinc-600">End-to-End Encrypted Session</span>
      </div>
    </div>

    <!-- Right Pane: Sign In & Register Form -->
    <div class="w-full lg:w-1/2 min-h-screen flex flex-col justify-between p-6 sm:p-10 lg:p-16 bg-zinc-950 relative overflow-y-auto">
      <!-- Glow effect -->
      <div class="absolute top-0 right-0 w-80 h-80 bg-blue-600/10 rounded-full blur-[100px] pointer-events-none"></div>

      <!-- Top bar -->
      <div class="relative z-10 flex items-center justify-between w-full mb-8">
        <!-- Mobile Logo -->
        <a href={home} class="flex lg:hidden items-center gap-2">
          <img src="/logo.jpg" alt="ZilyaDigital Logo" width={32} height={32} class="rounded-lg shadow-sm" />
          <span class="text-lg font-bold text-white tracking-tight">ZilyaDigital</span>
        </a>

        <!-- Back to Home Pill Button -->
        <a
          href={home}
          class="ml-auto inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-zinc-400 hover:text-white transition-all bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full shadow-sm"
        >
          <ArrowLeft name="arrow-left" class="w-4 h-4" />
          <span>Back to Home</span>
        </a>
      </div>

      <!-- Form container -->
      <div class="relative z-10 w-full max-w-md mx-auto my-auto py-6">
        <ClientLoginForm client:load lang={lang} turnstileSiteKey={turnstileSiteKey} />
      </div>

      <!-- Bottom link/note -->
      <div class="relative z-10 w-full text-center text-xs text-zinc-500 pt-6">
        <p>
          By signing in or registering, you agree to our{' '}
          <a href="/en/terms" target="_blank" class="text-zinc-400 hover:text-white underline decoration-zinc-600 transition-colors">Terms of Service</a>{' '}
          and{' '}
          <a href="/en/privacy" target="_blank" class="text-zinc-400 hover:text-white underline decoration-zinc-600 transition-colors">Privacy Policy</a>.
        </p>
      </div>
    </div>
  </body>
</html>