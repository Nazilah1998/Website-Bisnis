---
import '../../../styles/globals.css';
import type { Locale } from '@/i18n/ui';
import { getLangFromUrl, localeHref } from '@/i18n/utils';
import ClientLoginForm from '@/components/client/ClientLoginForm.tsx';
import ArrowLeft from '@/components/Lucide.astro';

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const home = localeHref(lang, '/');
const year = new Date().getFullYear();
---

<html lang={lang} class="h-full antialiased scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400..900&family=Geist+Mono:wght@400..700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <title>Client Portal | ZilyaDigital</title>
  </head>
  <body class="min-h-screen w-full flex bg-background">
    <div class="hidden lg:flex w-1/2 bg-zinc-950 relative overflow-hidden flex-col justify-between p-12">
      <div class="absolute top-0 left-0 w-full h-full">
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-indigo-600/20 rounded-full blur-[100px]" />
        <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-cyan-500/20 rounded-full blur-[100px]" />
      </div>

      <div class="relative z-10 flex items-center gap-2">
        <img src="/logo.jpg" alt="ZilyaDigital Logo" width={32} height={32} class="rounded-md" />
        <span class="text-2xl font-bold text-white tracking-tight">ZilyaDigital</span>
      </div>

      <div class="relative z-10 max-w-md">
        <h1 class="text-4xl font-bold text-white mb-6 leading-tight">
          Client Portal
        </h1>
        <p class="text-zinc-400 text-lg leading-relaxed">
          Track project progress, download assets, settle invoices, and submit support tickets in one place.
        </p>
      </div>

      <div class="relative z-10">
        <p class="text-sm text-zinc-500">
          &copy; {year} ZilyaDigital. All rights reserved.
        </p>
      </div>
    </div>

    <div class="w-full lg:w-1/2 flex items-center justify-center p-8 lg:p-24 bg-white dark:bg-zinc-950 relative">
      <a
        href={home}
        class="absolute top-8 right-8 flex items-center gap-2 text-sm font-medium text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white transition-colors bg-zinc-100 dark:bg-zinc-900 px-4 py-2 rounded-lg"
      >
        <ArrowLeft name="arrow-left" class="w-4 h-4" />
        Back to Home
      </a>
      <div class="w-full max-w-md space-y-8">
        <div class="text-center lg:text-left">
          <h2 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">Welcome Back</h2>
          <p class="text-sm text-zinc-500 mt-2">
            Sign in with your registered email to view your projects and invoices.
          </p>
        </div>

        <ClientLoginForm client:load lang={lang} />
      </div>
    </div>
  </body>
</html>