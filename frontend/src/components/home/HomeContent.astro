---
import type { Locale } from '@/i18n/ui';
import { t, localeHref } from '@/i18n/utils';
import { getPublic } from '@/lib/server';
import type {
  ClientLogoRecord,
  ServiceRecord,
  PortfolioRecord,
  TestimonialRecord,
  PricingRecord,
  FaqRecord,
  PostRecord,
  StatRecord,
} from '@/lib/records';
import FloatingLines from '@/components/ui/FloatingLines.tsx';
import { ShinyText } from '@/components/ui/ShinyText.tsx';
import StatsBar from '@/components/home/StatsBar.tsx';
import ServicesGrid from '@/components/home/ServicesGrid.tsx';
import PortfolioGrid from '@/components/home/PortfolioGrid.tsx';
import PricingGrid from '@/components/home/PricingGrid.tsx';
import TestimonialsCarousel from '@/components/home/TestimonialsCarousel.tsx';
import FaqsAccordion from '@/components/home/FaqsAccordion.tsx';
import BlogPreview from '@/components/home/BlogPreview.astro';
import ClientLogos from '@/components/home/ClientLogos.astro';
import BookingForm from '@/components/home/BookingForm.tsx';
import ChatbotWidget from '@/components/home/ChatbotWidget.tsx';
import HeroVisualPreview from '@/components/home/HeroVisualPreview.tsx';
import HeroActionButtons from '@/components/home/HeroActionButtons.tsx';
import TechStackMarquee from '@/components/home/TechStackMarquee.tsx';
import CoreWebVitalsScorecard from '@/components/home/CoreWebVitalsScorecard.tsx';
import ProjectCostCalculator from '@/components/home/ProjectCostCalculator.tsx';
import WebsiteAuditTool from '@/components/home/WebsiteAuditTool.tsx';

interface Props {
  lang: Locale;
}

const lang = Astro.props.lang;

const [services, logos, portfolios, testimonials, plans, faqs, posts, stats] = await Promise.all([
  getPublic<ServiceRecord>('services', { filter: 'isActive=true' }),
  getPublic<ClientLogoRecord>('clientLogos', { filter: 'isActive=true' }),
  getPublic<PortfolioRecord>('portfolios', { sort: '-created' }),
  getPublic<TestimonialRecord>('testimonials', { sort: '-created' }),
  getPublic<PricingRecord>('pricingPlans'),
  getPublic<FaqRecord>('faqs', { sort: 'orderIdx' }),
  getPublic<PostRecord>('posts', { filter: 'isPublished=true', sort: '-created' }),
  getPublic<StatRecord>('stats', { sort: 'orderIdx' }),
]);

const isEn = lang === 'en';

const hp = {
  title: isEn
    ? 'High-Performance Web Architecture & Enterprise Solutions'
    : 'Transformasi Digital & Arsitektur Web Skala Enterprise',
  subtitle: isEn
    ? 'We engineer ultra-fast web platforms (Astro 7 + Go Fiber), native mobile PWAs, and custom AI agents built for relentless conversion and scale.'
    : 'Kami membangun website berkecepatan kilat (Astro 7 + Go Fiber), aplikasi mobile PWA, dan solusi AI cerdas yang dirancang untuk melipatgandakan omzet bisnis Anda.',
};

const labels = {
  services: {
    title: isEn ? 'Enterprise Engineering Services' : 'Layanan & Arsitektur Digital',
    subtitle: isEn
      ? 'Comprehensive full-stack engineering tailored for modern high-growth businesses.'
      : 'Solusi digital komprehensif dari frontend kilat, backend Go berkinerja tinggi, hingga integrasi payment & AI.',
  },
  portfolio: {
    title: isEn ? 'Featured Works & Case Studies' : 'Portofolio & Studi Kasus Teruji',
    subtitle: isEn
      ? 'Real results engineered for clients across retail, enterprise, and fintech industries.'
      : 'Karya digital terbaik yang telah terbukti meningkatkan kecepatan, citra profesional, dan omzet klien kami.',
  },
  pricing: {
    title: t(lang, 'Pricing.title'),
    subtitle: t(lang, 'Pricing.subtitle'),
    popular: t(lang, 'Pricing.popular'),
    per_project: t(lang, 'Pricing.per_project'),
    contact_us: t(lang, 'Pricing.contact_us'),
    custom_quote: t(lang, 'Pricing.custom_quote'),
  },
  testimonials: {
    title: isEn ? 'What Our Clients Say' : 'Apa Kata Klien Kami',
    subtitle: isEn
      ? 'Real experiences from businesses that scaled with our digital architecture.'
      : 'Pengalaman nyata dari mereka yang telah mempercayakan transformasi digitalnya kepada kami.',
  },
  faqs: {
    title: isEn ? 'Frequently Asked Questions' : 'Pertanyaan yang Sering Diajukan',
    subtitle: isEn
      ? 'Find answers to common questions about our development workflow and guarantees.'
      : 'Temukan jawaban atas pertanyaan umum terkait proses pengerjaan, garansi, dan teknologi.',
  },
};

const bookingHref = localeHref(lang, '/#booking');
const calculatorHref = localeHref(lang, '/#calculator');
---

<!-- Hero Section with Double-Bezel Visual Preview -->
<section class="relative min-h-[92vh] pt-32 pb-20 flex flex-col items-center justify-center overflow-hidden">
  <div class="absolute inset-0 z-0 bg-black">
    <FloatingLines
      client:load
      enabledWaves={['top', 'middle', 'bottom']}
      lineCount={[4, 6, 8]}
      lineDistance={[8, 6, 4]}
      bendRadius={5.0}
      bendStrength={-0.5}
      interactive={true}
      parallax={true}
      linesGradient={['#3b82f6', '#6366f1', '#a855f7', '#06b6d4']}
    />
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[380px] bg-blue-500/10 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-background/40 to-background pointer-events-none"></div>
  </div>

  <div class="container relative z-10 mx-auto px-4 text-center">
    <!-- Eyebrow Pill -->
    <div class="inline-flex items-center rounded-full border border-blue-500/30 bg-blue-500/10 px-4 py-1.5 text-xs font-semibold tracking-[0.2em] text-blue-400 backdrop-blur-md mb-8 shadow-inner">
      <span class="flex h-2 w-2 rounded-full bg-blue-400 mr-2.5 animate-pulse"></span>
      ELEVATE YOUR DIGITAL PRESENCE
    </div>

    <!-- Main Editorial Headline -->
    <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight mb-6 max-w-5xl mx-auto leading-[1.12]">
      <ShinyText client:load text={hp.title} />
    </h1>

    <!-- Subtitle -->
    <p class="text-base sm:text-lg md:text-xl text-zinc-300 max-w-[820px] mb-10 leading-relaxed mx-auto font-normal">
      {hp.subtitle}
    </p>

    <!-- CTAs with Button-in-Button & 15-Min Meeting Scheduler -->
    <HeroActionButtons
      client:load
      bookingHref={bookingHref}
      calculatorHref={calculatorHref}
      lang={lang}
    />

    <!-- Interactive 3D Flagship Visual Mockup -->
    <HeroVisualPreview client:load lang={lang} />
  </div>
</section>

<!-- Infinite Modern Tech Stack Marquee -->
<TechStackMarquee client:load lang={lang} />

<!-- Key Business Statistics -->
<StatsBar client:load lang={lang} stats={stats} />

<!-- Core Web Vitals 100/100 Live Scorecard -->
<CoreWebVitalsScorecard client:load lang={lang} />

<!-- Asymmetrical Bento Grid Services -->
<ServicesGrid client:load lang={lang} services={services} labels={labels.services} />

<!-- Interactive Project Cost Estimator -->
<ProjectCostCalculator client:load lang={lang} />

<!-- Proven Case Studies & Portfolio -->
<PortfolioGrid client:load lang={lang} items={portfolios} labels={labels.portfolio} />

<!-- Free Performance Website Audit Lead Magnet -->
<WebsiteAuditTool client:load lang={lang} />

<!-- Testimonials Carousel -->
<TestimonialsCarousel client:load lang={lang} items={testimonials} labels={labels.testimonials} />

<!-- Transparent Pricing Plans -->
<PricingGrid client:load lang={lang} plans={plans} labels={labels.pricing} />

<!-- Frequently Asked Questions -->
<FaqsAccordion client:load lang={lang} items={faqs} labels={labels.faqs} />

<!-- Blog & Knowledge Insights -->
<BlogPreview lang={lang} posts={posts} />

<!-- Trusted Client Logos -->
<ClientLogos lang={lang} logos={logos} />

<!-- Direct Consultation Booking Form -->
<BookingForm client:load />

<!-- Autonomous AI Floating Chatbot -->
<ChatbotWidget client:load />
