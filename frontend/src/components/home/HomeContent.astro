---
import type { Locale } from '@/i18n/ui';
import { t, localeHref } from '@/i18n/utils';
import { getPublic } from '@/lib/server';
import FloatingLines from '@/components/ui/FloatingLines.tsx';
import { ShinyText } from '@/components/ui/ShinyText.tsx';
import ServicesGrid from '@/components/home/ServicesGrid.tsx';
import PortfolioGrid from '@/components/home/PortfolioGrid.tsx';
import PricingGrid from '@/components/home/PricingGrid.tsx';
import TestimonialsCarousel from '@/components/home/TestimonialsCarousel.tsx';
import FaqsAccordion from '@/components/home/FaqsAccordion.tsx';
import BlogPreview from '@/components/home/BlogPreview.astro';
import ClientLogos from '@/components/home/ClientLogos.astro';
import BookingForm from '@/components/home/BookingForm.tsx';
import ChatbotWidget from '@/components/home/ChatbotWidget.tsx';
import { buttonVariants } from '@/components/ui/button';

interface Props {
  lang: Locale;
}

const lang = Astro.props.lang;

const [services, logos, portfolios, testimonials, plans, faqs, posts] = await Promise.all([
  getPublic('services', { filter: 'isActive=true' }),
  getPublic('clientLogos', { filter: 'isActive=true' }),
  getPublic('portfolios', { sort: '-created' }),
  getPublic('testimonials', { sort: '-created' }),
  getPublic('pricingPlans'),
  getPublic('faqs', { sort: 'orderIdx' }),
  getPublic('posts', { filter: 'isPublished=true', sort: '-created' }),
]);

const hp = {
  title: t(lang, 'HomePage.title'),
  subtitle: t(lang, 'HomePage.subtitle'),
  cta_booking: t(lang, 'HomePage.cta_booking'),
  cta_portfolio: t(lang, 'HomePage.cta_portfolio'),
};

const labels = {
  services: { title: t(lang, 'Services.title'), subtitle: t(lang, 'Services.subtitle') },
  portfolio: { title: t(lang, 'Portfolio.title'), subtitle: t(lang, 'Portfolio.subtitle') },
  pricing: {
    title: t(lang, 'Pricing.title'),
    subtitle: t(lang, 'Pricing.subtitle'),
    popular: t(lang, 'Pricing.popular'),
    per_project: t(lang, 'Pricing.per_project'),
    contact_us: t(lang, 'Pricing.contact_us'),
    custom_quote: t(lang, 'Pricing.custom_quote'),
  },
  testimonials: {
    title: lang === 'en' ? 'What Our Clients Say' : 'Apa Kata Klien Kami',
    subtitle: lang === 'en' ? 'Real experiences from those who have trusted us with their digital projects.' : 'Pengalaman nyata dari mereka yang telah mempercayakan proyek digitalnya kepada kami.',
  },
  faqs: {
    title: lang === 'en' ? 'Frequently Asked Questions' : 'Pertanyaan yang Sering Diajukan',
    subtitle: lang === 'en' ? 'Find answers to common questions about our services.' : 'Temukan jawaban atas pertanyaan umum terkait layanan kami.',
  },
};

const bookingHref = localeHref(lang, '/#booking');
const portfolioHref = localeHref(lang, '/#portfolio');
---

<section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 z-0 bg-black">
    <FloatingLines
      client:load
      enabledWaves={['top', 'middle', 'bottom']}
      lineCount={[4, 6, 8]}
      lineDistance={[8, 6, 4]}
      bendRadius={5.0}
      bendStrength={-0.5}
      interactive={true}
      parallax={true}
    />
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-background/50 to-background pointer-events-none"></div>
  </div>

  <div class="container relative z-10 mx-auto px-4 text-center">
    <div class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-sm font-medium backdrop-blur-md mb-8">
      <span class="flex h-2 w-2 rounded-full bg-blue-500 mr-2 animate-pulse"></span>
      Elevate Your Digital Presence
    </div>
    <h1 class="text-4xl md:text-5xl lg:text-7xl font-extrabold tracking-tight mb-6 max-w-4xl mx-auto">
      <ShinyText client:load text={hp.title} />
    </h1>
    <p class="text-lg sm:text-xl md:text-2xl text-muted-foreground max-w-[800px] mb-10 leading-relaxed mx-auto">
      {hp.subtitle}
    </p>
    <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center">
      <a href={bookingHref} class={buttonVariants({ size: "lg", className: "w-full sm:w-auto text-lg px-8 h-14 bg-white text-black hover:bg-gray-200" })}>
        {hp.cta_booking}
      </a>
      <a href={portfolioHref} class={buttonVariants({ variant: "outline", size: "lg", className: "w-full sm:w-auto text-lg px-8 h-14 border-white/20 hover:bg-white/10" })}>
        {hp.cta_portfolio}
      </a>
    </div>
  </div>
</section>

<ClientLogos logos={logos} />
<ServicesGrid client:load lang={lang} services={services} labels={labels.services} />
<PortfolioGrid client:load lang={lang} items={portfolios} labels={labels.portfolio} />
<TestimonialsCarousel client:load lang={lang} items={testimonials} labels={labels.testimonials} />
<PricingGrid client:load lang={lang} plans={plans} labels={labels.pricing} />
<FaqsAccordion client:load lang={lang} items={faqs} labels={labels.faqs} />
<BlogPreview lang={lang} posts={posts} />
<BookingForm client:load />
<ChatbotWidget client:load />