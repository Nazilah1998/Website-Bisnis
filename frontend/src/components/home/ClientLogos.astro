---
import type { Locale } from '@/i18n/ui';
import { localeHref } from '@/i18n/utils';

interface Props {
  lang: Locale;
  logos: Array<{ id: string; logoUrl?: string | null; name?: string | null }>;
}

const { lang, logos } = Astro.props;

if (logos.length === 0) return;
---

<section class="py-12 bg-background border-y border-white/5 overflow-hidden">
  <div class="container mx-auto px-4 mb-6 text-center">
    <p class="text-sm font-medium text-muted-foreground uppercase tracking-wider">Dipercaya oleh berbagai klien & menggunakan teknologi terkini</p>
  </div>
  <div class="relative flex max-w-[100vw] overflow-hidden group">
    <div class="animate-marquee flex w-max whitespace-nowrap group-hover:[animation-play-state:paused]">
      {[...logos, ...logos, ...logos, ...logos].map((logo, index) => (
        <div class="flex-shrink-0 mx-8 md:mx-16 flex items-center justify-center grayscale opacity-50 hover:grayscale-0 hover:opacity-100 transition-all duration-300">
          {logo.logoUrl ? <img src={logo.logoUrl} alt={logo.name ?? ''} width={120} height={60} class="object-contain h-12 w-auto max-w-[150px]" crossorigin /> : null}
        </div>
      ))}
    </div>
  </div>
</section>