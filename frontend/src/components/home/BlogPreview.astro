---
import type { Locale } from '@/i18n/ui';
import { localeHref } from '@/i18n/utils';
import { Calendar, ArrowRight } from 'lucide-react';

interface Props {
  lang: Locale;
  posts: Array<{
    id: string;
    slug?: string | null;
    category?: string | null;
    publishedAt?: string | null;
    titleId?: string | null;
    titleEn?: string | null;
    excerptId?: string | null;
    excerptEn?: string | null;
    coverImageUrl?: string | null;
  }>;
}

const { lang, posts } = Astro.props;
const latest = posts.slice(0, 3);

if (latest.length === 0) return;

function localeDate(value?: string | null) {
  const date = value ? new Date(value) : null;
  if (!date || Number.isNaN(date.getTime())) return '';
  return date.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
}
---

<section id="blog" class="py-24 bg-zinc-950/50">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-medium mb-4">
        Blog & Artikel
      </span>
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Insight Terbaru</h2>
      <p class="text-muted-foreground">Tips dan tutorial seputar dunia website dan bisnis digital.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {latest.map((post) => {
        const title = lang === 'en' ? post.titleEn : post.titleId;
        const excerpt = lang === 'en' ? post.excerptEn : post.excerptId;
        const href = localeHref(lang, `/blog/${post.slug}`);
        return (
          <a key={post.id} href={href} class="group block bg-card rounded-2xl border border-border overflow-hidden hover:shadow-xl hover:border-zinc-600 transition-all duration-300">
            <div class="aspect-video overflow-hidden bg-zinc-800">
              {post.coverImageUrl ? <img src={post.coverImageUrl} alt={title ?? ''} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" crossorigin /> : null}
            </div>
            <div class="p-5">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xs px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-400 capitalize">{post.category}</span>
                <span class="flex items-center gap-1 text-xs text-muted-foreground">
                  <Calendar class="w-3 h-3 text-muted-foreground inline" />
                  {localeDate(post.publishedAt)}
                </span>
              </div>
              <h3 class="font-bold text-foreground mb-2 group-hover:text-blue-400 transition-colors line-clamp-2">{title}</h3>
              <p class="text-sm text-muted-foreground line-clamp-2 mb-3">{excerpt}</p>
              <div class="flex items-center gap-1 text-sm font-medium text-blue-400">
                Baca <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <div class="text-center mt-10">
      <a href={localeHref(lang, '/blog')} class="inline-flex items-center gap-2 border border-zinc-700 hover:bg-zinc-800 text-zinc-300 px-6 py-2.5 rounded-lg text-sm font-medium transition-colors">
        Lihat Semua Artikel <ArrowRight class="w-4 h-4" />
      </a>
    </div>
  </div>
</section>