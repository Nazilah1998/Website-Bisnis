---
import type { Locale } from '@/i18n/ui';
import { localeHref } from '@/i18n/utils';
import Lucide from '@/components/Lucide.astro';
import type { PostRecord } from '@/lib/records';

interface Props {
  lang: Locale;
  post: PostRecord | null;
}

const { lang, post } = Astro.props;

function simpleMarkdown(md: string): string {
  return md
    .replace(/^### (.+)$/gm, '<h3 class="text-xl font-bold mt-8 mb-3 text-zinc-900 dark:text-zinc-100">$1</h3>')
    .replace(/^## (.+)$/gm, '<h2 class="text-2xl font-bold mt-10 mb-4 text-zinc-900 dark:text-zinc-100">$1</h2>')
    .replace(/^# (.+)$/gm, '<h1 class="text-3xl font-bold mt-10 mb-4 text-zinc-900 dark:text-zinc-100">$1</h1>')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>')
    .replace(/`(.+?)`/g, '<code class="bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded text-sm font-mono">$1</code>')
    .replace(/^- (.+)$/gm, '<li class="ml-4 list-disc">$1</li>')
    .replace(/^(\d+)\. (.+)$/gm, '<li class="ml-4 list-decimal">$2</li>')
    .replace(/\n\n/g, '</p><p class="mb-4 text-zinc-600 dark:text-zinc-400 leading-relaxed">')
    .replace(/^(?!<[h|l])(.+)$/gm, '$1');
}

function tagsOf(value?: string | null): string[] {
  if (!value) return [];
  try {
    const parsed = JSON.parse(value);
    return Array.isArray(parsed) ? parsed.map(String) : [];
  } catch {
    return [];
  }
}

function localeDate(value?: string | null) {
  if (!value) return '';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '';
  return date.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
}
---

{post ? (
  <div class="min-h-screen bg-background">
    <div class="w-full h-72 md:h-96 overflow-hidden bg-zinc-800 relative">
      {post.coverImageUrl ? <img src={post.coverImageUrl} alt={post.titleId ?? ''} class="w-full h-full object-cover opacity-80" crossorigin /> : null}
      <div class="absolute inset-0 bg-gradient-to-t from-background via-background/40 to-transparent" />
    </div>

    <div class="container mx-auto px-4 max-w-5xl -mt-20 relative z-10">
      <a href={localeHref(lang, '/blog')} class="inline-flex items-center gap-2 text-sm text-zinc-400 hover:text-zinc-200 mb-6 transition-colors">
        <Lucide name="arrow-left" class="w-4 h-4" /> Kembali ke Blog
      </a>

      <div class="bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-800 shadow-xl p-8 md:p-12">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400 capitalize flex items-center gap-1">
            <Lucide name="tag" class="w-3 h-3" /> {post.category}
          </span>
          <span class="flex items-center gap-1 text-xs text-zinc-400">
            <Lucide name="calendar" class="w-3 h-3" />
            {localeDate(post.publishedAt)}
          </span>
        </div>

        <h1 class="text-2xl md:text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50 mb-4">{lang === 'en' ? post.titleEn : post.titleId}</h1>
        <p class="text-lg text-zinc-500 dark:text-zinc-400 mb-8 leading-relaxed border-l-4 border-blue-500/40 pl-4 italic">{lang === 'en' ? post.excerptEn : post.excerptId}</p>

        <div
          class="prose prose-zinc dark:prose-invert max-w-none text-zinc-600 dark:text-zinc-400 leading-relaxed"
          set:html={`<p class="mb-4 text-zinc-600 dark:text-zinc-400 leading-relaxed">${simpleMarkdown(lang === 'en' ? post.contentEn : post.contentId)}</p>`}
        />

        {tagsOf(post.tags).length > 0 && (
          <div class="flex flex-wrap gap-2 mt-10 pt-6 border-t border-zinc-200 dark:border-zinc-800">
            {tagsOf(post.tags).map((tag, i) => (
              <span key={i} class="text-xs px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
                #{tag}
              </span>
            ))}
          </div>
        )}

        <div class="mt-10 p-6 rounded-xl bg-blue-50 dark:bg-blue-900/20 border border-blue-100 dark:border-blue-800/30 text-center">
          <p class="font-bold text-zinc-900 dark:text-zinc-100 mb-1">Butuh Website Profesional?</p>
          <p class="text-sm text-zinc-500 mb-4">Konsultasikan kebutuhan Anda dengan tim kami sekarang.</p>
          <a href={localeHref(lang, '/#booking')} class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg text-sm font-medium transition-colors">
            Konsultasi Gratis <Lucide name="external-link" class="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
    <div class="h-16" />
  </div>
) : (
  <div class="container mx-auto px-4 py-24 text-center text-zinc-400">
    <h1 class="text-3xl font-bold text-white mb-4">Artikel Tidak Ditemukan</h1>
    <a href={localeHref(lang, '/blog')} class="text-blue-400 hover:underline">Kembali ke Blog</a>
  </div>
)}