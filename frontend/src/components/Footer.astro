---
import type { Locale } from '@/i18n/ui';
import { localeHref } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

function href(path: string) {
  return path.startsWith('#') ? `${localeHref(locale, '/')}${path}` : localeHref(locale, path);
}
---

<footer class="bg-[#050505] border-t border-white/10 pt-16 pb-8">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <div class="col-span-1 md:col-span-2">
        <a href={href('/')} class="font-bold text-2xl tracking-tight mb-4 inline-block text-white">
          Zilya<span class="text-blue-500">Digital</span>
        </a>
        <p class="text-zinc-400 text-sm max-w-md mb-6 leading-relaxed">
          Agensi pengembangan web independen yang berdedikasi membangun ekosistem digital premium untuk bisnis dan UMKM di seluruh dunia.
        </p>
        <div class="flex gap-4">
          <a href="#" aria-label="Instagram" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-pink-600 transition-colors text-white">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="w-5 h-5"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
          <a href="#" aria-label="TikTok" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-black transition-colors text-white">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1.04-.1z" /></svg>
          </a>
          <a href="#" aria-label="YouTube" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-red-600 transition-colors text-white">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="w-5 h-5"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>
          </a>
          <a href="#" aria-label="GitHub" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-zinc-700 transition-colors text-white">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="w-5 h-5"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          </a>
          <a href="#" aria-label="LinkedIn" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-blue-700 transition-colors text-white">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="w-5 h-5"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
          <a href="#" aria-label="Twitter / X" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-blue-400 transition-colors text-white">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="text-white font-semibold mb-4">Navigasi</h4>
        <ul class="space-y-3">
          <li><a href={href('/')} class="text-sm text-zinc-400 hover:text-white transition-colors">Beranda</a></li>
          <li><a href={href('/about')} class="text-sm text-zinc-400 hover:text-white transition-colors">Tentang Kami</a></li>
          <li><a href={href('/#services')} class="text-sm text-zinc-400 hover:text-white transition-colors">Layanan</a></li>
          <li><a href={href('/#portfolio')} class="text-sm text-zinc-400 hover:text-white transition-colors">Portofolio</a></li>
          <li><a href={href('/client/login')} class="text-sm text-zinc-400 hover:text-white transition-colors">Client Portal</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-semibold mb-4">Kontak</h4>
        <ul class="space-y-3">
          <li class="flex items-center gap-2 text-sm text-zinc-400">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="w-4 h-4"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            nazilahdeveloper@gmail.com
          </li>
          <li class="text-sm text-zinc-400">
            Muara Teweh, Kalimantan Tengah, Indonesia
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-zinc-500">
        &copy; {new Date().getFullYear()} ZilyaDigital. All rights reserved.
      </p>
      <div class="flex gap-4">
        <a href={href('/privacy')} class="text-xs text-zinc-500 hover:text-white transition-colors">Privacy Policy</a>
        <a href={href('/terms')} class="text-xs text-zinc-500 hover:text-white transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>