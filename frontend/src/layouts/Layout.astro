---
import '../styles/globals.css';
import type { Locale } from '@/i18n/ui';
import { t, getLangFromUrl, localeHref } from '@/i18n/utils';
import Header from '@/components/Header.tsx';
import Footer from '@/components/Footer.astro';
import { Toaster } from 'sonner';
import type { NavLabels } from '@/components/Header.tsx';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const { title = 'Platform Agensi Jasa Pembuatan Website', description = 'Kami membangun website premium untuk bisnis Anda.', locale } = Astro.props;

const lang = locale ?? getLangFromUrl(Astro.url);
const pathname = Astro.url.pathname;
const hiddenChrome = pathname.includes('/admin');

// Path halaman saat ini tanpa prefix lokale (untuk LanguageSwitcher).
const segments = pathname.split('/');
const cleanPath = lang !== 'id' && segments[1] === lang ? '/' + segments.slice(2).join('/') : pathname;

const navLabels: NavLabels = {
  home: t(lang, 'Navigation.home'),
  services: t(lang, 'Navigation.services'),
  portfolio: t(lang, 'Navigation.portfolio'),
  pricing: t(lang, 'Navigation.pricing'),
  testimonials: t(lang, 'Navigation.testimonials'),
  faqs: t(lang, 'Navigation.faqs'),
  about: t(lang, 'Navigation.about'),
};
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://zilya.id').toString();
const ogImageUrl = new URL('/logo.jpg', Astro.site ?? 'https://zilya.id').toString();
---

<html lang={lang} class="dark h-full antialiased scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090b" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / WhatsApp / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZilyaDigital" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'id_ID'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "ZilyaDigital",
      "image": ogImageUrl,
      "url": "https://zilya.id",
      "telephone": "+6281234567890",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Muara Teweh",
        "addressRegion": "Kalimantan Tengah",
        "addressCountry": "ID"
      },
      "description": description,
    })} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <title>{title}</title>
  </head>
  <body class="min-h-full flex flex-col bg-background text-foreground">
    {!hiddenChrome && (
      <Header client:load locale={lang} labels={navLabels} />
    )}
    <main class="flex-1">
      <slot />
    </main>
    {!hiddenChrome && <Footer locale={lang} />}
    <Toaster client:load richColors position="bottom-right" />
  </body>
</html>